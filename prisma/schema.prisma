generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TaskStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  displayName  String
  role         UserRole
  status       UserStatus @default(ACTIVE)
  baseUserId   String?
  baseContext  Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  taughtClasses  ClassBinding[] @relation("ClassTeacher")
  memberships    ClassMember[]
  createdTasks   ClassTask[]    @relation("TaskTeacher")
  submissions    Submission[]   @relation("StudentSubmissions")
}

model StudentProfile {
  id            String  @id @default(cuid())
  userId        String  @unique
  ageBand       String?
  displayAvatar String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id     String  @id @default(cuid())
  userId String  @unique
  title  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClassBinding {
  id             String   @id @default(cuid())
  externalClassId String  @unique
  externalOrgId  String?
  name           String
  teacherId      String
  baseContext    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teacher     User          @relation("ClassTeacher", fields: [teacherId], references: [id])
  memberships ClassMember[]
  tasks       ClassTask[]
}

model ClassMember {
  id             String   @id @default(cuid())
  classBindingId String
  userId         String
  externalRole   String?
  joinedAt       DateTime @default(now())

  classBinding ClassBinding @relation(fields: [classBindingId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classBindingId, userId])
}

model TaskTemplate {
  id               String   @id @default(cuid())
  key              String   @unique
  title            String
  summary          String
  promptSeed       String
  safetyGuidelines String
  minAge           Int      @default(7)
  maxAge           Int      @default(10)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tasks ClassTask[]
}

model ClassTask {
  id             String     @id @default(cuid())
  templateId     String
  classBindingId String
  teacherId      String
  title          String
  instructions   String
  status         TaskStatus @default(ACTIVE)
  displayEnabled Boolean    @default(false)
  dueAt          DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  template     TaskTemplate @relation(fields: [templateId], references: [id])
  classBinding ClassBinding @relation(fields: [classBindingId], references: [id], onDelete: Cascade)
  teacher      User         @relation("TaskTeacher", fields: [teacherId], references: [id])
  submissions  Submission[]
}

model Submission {
  id          String           @id @default(cuid())
  classTaskId String
  studentId   String
  textContent String
  imageUrl    String?
  status      SubmissionStatus @default(SUBMITTED)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  classTask  ClassTask    @relation(fields: [classTaskId], references: [id], onDelete: Cascade)
  student    User         @relation("StudentSubmissions", fields: [studentId], references: [id])
  aiFeedback AiFeedback?

  @@unique([classTaskId, studentId])
}

model AiFeedback {
  id           String   @id @default(cuid())
  submissionId String   @unique
  summary      String
  guidance     String
  safetyNotes  String
  rawProvider  Json?
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
